rules_version = '2';

// Ploggy Firebase Storage 보안 규칙
// 배포: Firebase 콘솔 > Storage > 규칙 에 붙여넣기, 또는 `firebase deploy --only storage`
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 5MB 이하 이미지만 올릴 수 있습니다.
    function isImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // 쓰레기 분류 사진, 다이어리 사진: 본인만
    match /images/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImageUpload();
    }
    match /diary_images/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isImageUpload();
    }

    // 커뮤니티 사진: 로그인한 사용자는 모두 볼 수 있음
    match /community_images/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && isImageUpload();
    }
  }
}
